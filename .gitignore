# Add to your existing .gitignore
cat >> .gitignore << 'EOF'

# ============================================
# Research-Specific Additions
# ============================================

# Virtual environments (you already have these but let's be explicit)
3d-venv/

# Large datasets (DON'T commit these!)
Replica-Dataset/
replica_data/
replica_v1*/
scannet_data/
temporal_training_data/
temporal_sequences/
demo_data/
data/
datasets/

# Point cloud files
*.ply
*.pcd
*.obj
*.stl

# Depth/RGB data
*.exr
*.hdr
*.depth

# Compressed data
*.tar.gz
*.zip
*.7z
*.rar

# Model checkpoints (can be huge!)
checkpoints/
*.pth
*.pt
*.ckpt
*.h5
*.pb
*.onnx

# Experiment results
results/
outputs/
experiments/
logs/
runs/
wandb/

# Generated figures
figures/
plots/
visualizations/
*.png
*.jpg
*.jpeg
*.gif
*.mp4
*.avi

# Temporary/backup files
old/
backup/
tmp/
temp/
scratch/

# macOS specific
.DS_Store
.AppleDouble
.LSOverride

# Thumbnails
._*

# Files that might appear in the root of a volume
.DocumentRevisions-V100
.fseventsd
.Spotlight-V100
.TemporaryItems
.Trashes
.VolumeIcon.icns
.com.apple.timemachine.donotpresent

# Directories potentially created on remote AFP share
.AppleDB
.AppleDesktop
Network Trash Folder
Temporary Items
.apdisk

# Jupyter
.ipynb_checkpoints/
*.ipynb

# Annotations
annotations/
*.json.backup

# LaTeX paper files
*.aux
*.bbl
*.blg
*.log
*.out
*.synctex.gz
*.fdb_latexmk
*.fls

# Paper submissions
paper/submission/
paper/*.pdf

EOF